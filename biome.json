{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "scripts/**/*.ts",
      "packages/registry/scripts/**/*.ts",
      "tests/**/*.ts",
      "apps/docs/**/*.ts",
      "apps/docs/**/*.mjs",
      "apps/docs/**/*.json",
      "!apps/docs/.astro/*",
      "!apps/docs/src/data/*",
      "*.ts",
      "*.json",
      "!node_modules",
      "!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
