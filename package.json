{
  "name": "rnr-ai-elements",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "bash scripts/install-git-hooks.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "hooks:check": "righthook run pre-commit",
    "typecheck": "tsc --noEmit && pnpm --filter @rnr-ai-elements/registry typecheck",
    "lint": "biome ci .",
    "check:fallow": "fallow audit --base HEAD",
    "test": "vitest run",
    "storybook:device": "pnpm --filter harness storybook:device",
    "storybook:web": "pnpm --filter harness storybook:web",
    "registry:build": "tsx packages/registry/scripts/build-registry.ts",
    "e2e:docs": "pnpm --filter @rnr-ai-elements/docs build && pnpm exec playwright install chromium && pnpm exec playwright test",
    "e2e:smoke:ios": "bash tests/sprint-01/install-core.test.sh --smoke ios",
    "e2e:smoke:android": "bash tests/sprint-01/install-core.test.sh --smoke android",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:registry": "tsx scripts/check-registry-fresh.ts",
    "check:contract": "tsx scripts/check-contract.ts",
    "gallery:manifest": "tsx scripts/build-gallery-manifest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "fallow": "3.25.0",
    "qrcode": "^1.5.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
