{
  "name": "rnr-ai-elements",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "vitest run",
    "storybook:device": "pnpm --filter harness storybook:device",
    "storybook:web": "pnpm --filter harness storybook:web",
    "registry:build": "tsx packages/registry/scripts/build-registry.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:registry": "tsx scripts/check-registry-fresh.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
