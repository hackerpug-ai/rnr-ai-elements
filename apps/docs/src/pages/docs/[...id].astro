---
/**
 * /docs/[...id] — the catch-all static route for authored documentation
 * (CAP-DOCS-01), scoped to getting-started entries only (GBC-009). getStaticPaths
 * fans one page per published getting-started entry (drafts excluded, the
 * reserved theming slug excluded so the static /docs/theming route stays
 * authoritative, and the guides/porting sections excluded — they publish at
 * /guides/{slug} and /porting through their own routes, never at /docs/{slug}),
 * through the real collection loader. Each page renders the manuscript via
 * `render()` — the authored MDX binding contract — and hands the result, its
 * source-derived headings, and the publication navigation to MarkdownLayout.
 * The edit URL identifies the manuscript's recorded path under
 * apps/docs/src/content/docs/.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import {
  assertUniqueDestinations,
  publishedDocs,
  sectionNavigation,
  type DocsCollectionEntry,
  type PublishedDoc,
  type SectionNavGroup,
} from '../../lib/docs-navigation';

export async function getStaticPaths() {
  // Deterministic collision gate: the raw sources must resolve to unique
  // published destinations before any route is generated (the loader's own
  // duplicate warning races under concurrent file processing). getStaticPaths
  // runs in its own prerender scope, so resolve the content dir from the build
  // process cwd (the docs project root) rather than a module-level const.
  const contentDir = join(process.cwd(), 'src', 'content', 'docs');
  await assertUniqueDestinations(contentDir);
  const entries = await getCollection('docs');
  const typed = entries as unknown as DocsCollectionEntry[];
  // Single-tutorial gate (UC-DOCS-02): the complete published collection must
  // carry exactly one tutorial designation at /docs/quickstart, validated over
  // every entry BEFORE any route filtering, so a draft copy cannot hide a
  // duplicate and a violation names the offending sources instead of
  // rendering. The gate module lives outside this Astro project root — a
  // boundary the bundler refuses to resolve statically — so the route
  // generator loads it through Node's own ESM loader in the same Node process
  // that executes this build (native TS stripping; the file is erasable-only
  // TypeScript).
  const gate = await import(
    /* @vite-ignore */ pathToFileURL(
      join(process.cwd(), '..', '..', 'scripts', 'docs-data', 'single-tutorial.ts'),
    ).href
  );
  gate.assertSinglePublishedTutorial(typed);
  const nav = sectionNavigation(typed);
  const docs = publishedDocs(typed).filter((doc) => doc.section === 'getting-started');
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc, nav },
  }));
}

interface Props {
  doc: PublishedDoc;
  nav: SectionNavGroup[];
}

const { doc, nav } = Astro.props;

const entry = await getEntry('docs', doc.id);
if (!entry) {
  throw new Error(`[docs/${doc.id}] collection entry vanished after publication derivation`);
}

const { Content, headings } = await render(entry);

const editUrl = `https://github.com/hackerpug-ai/rnr-ai-elements/blob/main/${doc.sourcePath}`;
---

<MarkdownLayout
  title={doc.title}
  description={doc.description}
  section={doc.section}
  headings={headings}
  nav={nav}
  editUrl={editUrl}
  id={doc.id}
>
  <Content />
</MarkdownLayout>
