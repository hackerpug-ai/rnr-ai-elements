---
/**
 * /docs/theming (ORI-AST-003) — the static route that binds ORI-CONT-002's
 * reviewed collection manuscript to the real TokenTable component.
 *
 * The authored manuscript (`src/content/docs/theming.mdx`) declares exactly one
 * bare `<TokenTable />` with no import — the content contract forbids importing
 * the absent component. Astro's `render(entry)` exposes the `Content` component,
 * and the `<Content components={{ TokenTable }} />` prop is the render-time
 * binding that supplies it. The catch-all (`/docs/[...id]`) excludes the
 * reserved `theming` slug (docs-navigation RESERVED_DOC_SLUGS), so this static
 * route stays the single destination and the manuscript renders only here.
 *
 * The heading texts `TextClassContext` and `renderMarkdown` are preserved from
 * the manuscript, so `/docs/theming#textclasscontext` and
 * `/docs/theming#rendermarkdown` keep resolving through the same github-slugger
 * ids the collection nav derives.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { join, sep } from 'node:path';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import TokenTable from '../../components/TokenTable.astro';
import {
  assertUniqueDestinations,
  sectionNavigation,
  type DocsCollectionEntry,
  type SectionNavGroup,
} from '../../lib/docs-navigation';

// The publication contract the catch-all uses: the raw sources must resolve to
// unique destinations before any route renders, and the section navigation
// derives from the same published set.
const contentDir = join(process.cwd(), 'src', 'content', 'docs');
assertUniqueDestinations(contentDir);
const entries = await getCollection('docs');
const nav: SectionNavGroup[] = sectionNavigation(entries as unknown as DocsCollectionEntry[]);

const entry = await getEntry('docs', 'theming');
if (!entry) {
  throw new Error('[docs/theming] the reviewed theming collection entry is missing');
}

const { Content, headings } = await render(entry);

const sourcePath = entry.filePath
  ? `apps/docs/${entry.filePath.split(sep).join('/')}`
  : 'apps/docs/src/content/docs/theming.mdx';
const editUrl = `https://github.com/hackerpug-ai/rnr-ai-elements/blob/main/${sourcePath}`;
---

<MarkdownLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  headings={headings}
  nav={nav}
  editUrl={editUrl}
  id="theming"
>
  <Content components={{ TokenTable }} />
</MarkdownLayout>
