---
/**
 * SHELL-008 — generated component reference page on the DocsLayout shell.
 * getStaticPaths fans one page per registry:component entry in the FUSE-05
 * dataset (39 pages, slug = item name) — never hand-written per page.
 * Anatomy: header + chip row, the engine-tabbed InstallCommand composite as
 * FIRST content section (SHELL-004; both engine commands server-rendered),
 * then the data-verbatim DependencyPanel (SHELL-006's resolve-deps resolves
 * in frontmatter — the served HTML is already concrete), then the full
 * untruncated nativewind source, then the within-family pager.
 * No preview panel this sprint (T-GEND-021): omitted, never a placeholder.
 */
import { readFileSync } from 'node:fs';
import DependencyPanel from '../../components/DependencyPanel.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import families from '../../data/families.json';
import items from '../../data/registry-items.json';
import siteFacts from '../../data/site-facts.json';
import { resolveRegistryDependencies } from '../../lib/resolve-deps';
import Layout from '../../layouts/DocsLayout.astro';

interface Props {
  item: (typeof items)[number];
}

export async function getStaticPaths() {
  return items
    .filter((entry) => entry.type === 'registry:component')
    .map((entry) => ({ params: { item: entry.name }, props: { item: entry } }));
}

const { item } = Astro.props;

/** The source view renders the nativewind form (the served /r default). */
const DEFAULT_ENGINE = 'nativewind';

// The release version the chip carries AND the {version} substitution the
// dependency URLs resolve with — one build-time read of the ROOT
// package.json, so a version bump moves chip, URLs, and raw.githubusercontent
// pins together, never apart. The ordered build chain runs astro from
// apps/docs, so the path resolves there; a wrong cwd fails the build rather
// than rendering a stale page.
const { version } = JSON.parse(readFileSync('../../package.json', 'utf8')) as { version: string };

const family = families.find((entry) => entry.itemNames.includes(item.name));
if (!family) {
  throw new Error(`[components/${item.name}] has no family in families.json`);
}
const memberIndex = family.itemNames.indexOf(item.name);
const prevName = family.itemNames[(memberIndex - 1 + family.itemNames.length) % family.itemNames.length];
const nextName = family.itemNames[(memberIndex + 1) % family.itemNames.length];

// The dependencies panel's engine forms resolve HERE through the one
// resolver (SHELL-006) — never in markup, never hand-typed. Both engines
// resolve so both forms are server-rendered (the inactive one hidden only).
const resolvedRegistryUrls = {
  nativewind: resolveRegistryDependencies(item.registryDependencies, 'nativewind', version),
  uniwind: resolveRegistryDependencies(item.registryDependencies, 'uniwind', version),
};

const sourceFiles = item.sourceFiles.map((file) => ({
  filename: file.filename,
  // The same {engine} substitution the registry fan-out applies (Vite's build
  // resolver cannot import the helper across the package root, so the one-line
  // form lives here); the spec's byte-compare against the served
  // /r/{engine}/{item}.json fails the build if the two ever drift.
  text: file.text.split('{engine}').join(DEFAULT_ENGINE),
}));
---

<Layout title={`${item.title} — RNR AI Elements`}>
  <main class="component-page">
    <header class="page-header">
      <p class="breadcrumb">
        <a href="/components">Components</a> <span aria-hidden="true">/</span> {family.title}
      </p>
      <h1>{item.title}</h1>
      <p class="item-description">{item.description}</p>
      <ul class="chips" aria-label="Status">
        <li data-chip="version">v{version}</li>
        <li data-chip="category">{item.type.replace('registry:', '')}</li>
        {item.engines.map((engine) => <li data-chip="engine">{engine}</li>)}
        <li data-chip="expo">{item.expoGo ? 'Expo Go' : 'Dev client'}</li>
      </ul>
    </header>

    <section data-section="install" aria-labelledby="install-heading">
      <h2 id="install-heading">Install</h2>
      <InstallCommand item={item.name} />
    </section>

    <section data-section="dependencies" aria-labelledby="dependencies-heading">
      <h2 id="dependencies-heading">Dependencies</h2>
      <DependencyPanel
        dependencies={item.dependencies}
        registryUrls={resolvedRegistryUrls}
        peers={siteFacts.aiSdkPeers}
      />
    </section>

    <section data-section="source" aria-labelledby="source-heading">
      <h2 id="source-heading">Source</h2>
      {
        sourceFiles.map((file) => (
          <figure class="source-file">
            <figcaption>{file.filename}</figcaption>
            <pre><code>{file.text}</code></pre>
          </figure>
        ))
      }
    </section>

    <nav class="pager" aria-label="Family pager">
      <a rel="prev" href={`/components/${prevName}`}>← {prevName}</a>
      <a rel="next" href={`/components/${nextName}`}>{nextName} →</a>
    </nav>
  </main>
</Layout>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .breadcrumb {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .chips li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .source-file pre {
    overflow-x: auto;
    margin: 0;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 2rem;
  }
</style>
