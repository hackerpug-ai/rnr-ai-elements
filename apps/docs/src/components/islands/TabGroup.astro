---
/**
 * TabGroup — island 3/5 (SHELL-004). A generic, attribute-driven WAI-ARIA
 * tabs element: pass the labeled panels and slot each panel's content under
 * its engine name. Every tab and panel is server-rendered into the served
 * HTML — the bundled island only toggles the hidden attribute and (for
 * persistent engine groups) synchronizes the shared engine state, it never
 * fetches panel content.
 *
 * Two group kinds (ORI-AST-002):
 * - `persistent` (default) — an ENGINE group. It shares the `rnr-engine`
 *   storage key, updates `document.documentElement.dataset.engine`, and
 *   synchronizes every other engine group on the page through the one
 *   engine-state contract. Only `nativewind`/`uniwind` are ever persisted.
 * - `persistent={false}` — a GENERIC group (e.g. npm/pnpm). Its selection is
 *   local to the instance: no storage read/write, no root engine, no
 *   cross-group sync.
 *
 * Every rendered group carries a unique build-output prefix so `aria-controls`
 * / `aria-labelledby` resolve inside the owning group and tab/panel IDs never
 * collide when two groups share a page. An explicit `group` prop supplies the
 * prefix; callers that omit it (InstallCommand / DependencyPanel pass only
 * `panels` + slots) get a deterministic content digest — their slot content is
 * byte-distinct, so the digest disambiguates them without editing either
 * caller. The digest is stable across builds: same content, same prefix.
 *
 * The panels are rendered ONCE through `Astro.slots.render` and re-injected via
 * `set:html`; rendering a slot twice (once for the digest, once for the
 * template `<slot>`) would consume the child components' hoisted scripts.
 *
 * Zero-JS fallback: the first panel (nativewind) is the served default and
 * stays visible; `:not(:defined)` un-hides the remaining stacked panels so
 * every engine line is readable with no JS at all. An un-upgraded element is
 * fully readable content — never a dead control.
 */
import { createHash } from 'node:crypto';

interface Panel {
  /** Value stored under the element's storage-key; matches the panel DOM. */
  engine: string;
  label: string;
}

interface Props {
  panels: Panel[];
  /** Explicit group identity; when absent, derived from slot content. */
  group?: string;
  /** Persistent engine group (default); false = nonpersistent generic tabs. */
  persistent?: boolean;
}

const { panels, group, persistent = true } = Astro.props;

// Render each panel's slot exactly once; the rendered HTML feeds both the
// content digest and the template output (set:html), so child components'
// scripts/styles are hoisted exactly once.
const rendered = new Map<string, string>();
for (const panel of panels) {
  rendered.set(panel.engine, (await Astro.slots.render(panel.engine)) ?? '');
}

// Unique build-output prefix. An explicit `group` wins; otherwise a content
// digest of the first panel's rendered slot disambiguates co-located engine
// groups (InstallCommand vs DependencyPanel render byte-distinct content
// through identical `panels` props — the slot is the only build-time signal).
let groupId = group;
if (!groupId) {
  groupId = `g-${createHash('sha256').update(rendered.get(panels[0]?.engine ?? '') ?? '').digest('hex').slice(0, 12)}`;
}
---

<rnr-tab-group
  class="tab-group"
  storage-key="rnr-engine"
  data-persistent={persistent ? 'true' : 'false'}
>
  <div class="tab-group__tabs" role="tablist">
    {
      panels.map((panel, index) => (
        <button
          type="button"
          role="tab"
          id={`${groupId}-tab-${panel.engine}`}
          data-engine={panel.engine}
          aria-controls={`${groupId}-panel-${panel.engine}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-label={`${panel.engine} engine`}
          tabindex={index === 0 ? 0 : -1}
        >
          {panel.label}
        </button>
      ))
    }
  </div>
  {
    panels.map((panel, index) => (
      <div
        class="tab-group__panel"
        role="tabpanel"
        id={`${groupId}-panel-${panel.engine}`}
        data-engine={panel.engine}
        aria-labelledby={`${groupId}-tab-${panel.engine}`}
        tabindex="0"
        hidden={index !== 0}
      >
        <Fragment set:html={rendered.get(panel.engine)} />
      </div>
    ))
  }
</rnr-tab-group>

<script src="../../scripts/tab-group.ts"></script>

<style>
  .tab-group__tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  .tab-group__tabs [role='tab'] {
    min-height: 44px; /* touch target */
    padding: 0.25rem 0.75rem;
    font: inherit;
    color: var(--muted-foreground);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    cursor: pointer;
  }
  .tab-group__tabs [role='tab']:hover {
    color: var(--accent-foreground);
    background: var(--accent);
  }
  /* Active tab: the --primary fill, with the --ring bar as the indicator. */
  .tab-group__tabs [role='tab'][aria-selected='true'] {
    color: var(--primary-foreground);
    background: var(--primary);
    border-bottom-color: var(--ring);
  }
  .tab-group__panel {
    padding-block: 0.75rem;
  }
  .tab-group__panel:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  /* Zero-JS: hidden panels render stacked and labeled until the element
     upgrades; once defined, the island owns visibility via the attribute. */
  rnr-tab-group:not(:defined) [role='tabpanel'][hidden] {
    display: block;
  }
</style>
