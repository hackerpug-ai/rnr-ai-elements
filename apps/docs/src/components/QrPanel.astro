---
/**
 * QrPanel — the R6b/R12 QR aside (TR-07): zero JS, zero encoding. REF-008's
 * prebuild owns the encoder devDep and passes the finished inline SVG in as
 * the `svg` prop; this module renders it verbatim through its single
 * raw-HTML binding and never trims, rewrites, or regenerates it.
 *
 * qrDeepLink base: 'ai-elements-example' + '/' + item name — the app.json
 * expo.scheme. The link dead-ends until sprint-09 ships the gallery screens
 * (documented here so the dead-end stays discoverable), so the QR is a
 * non-interactive image this sprint: no anchor, no focusables.
 */
interface Props {
  item: string;
  svg: string;
}

const { item, svg } = Astro.props;
---

<aside data-qr-panel>
  <div role="img" aria-label={`Open the ${item} gallery screen in Expo Go`} set:html={svg} />
</aside>

<style>
  [data-qr-panel] {
    display: flex;
    justify-content: center;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
</style>
