---
/**
 * PageHeader (TR-07 R3) — the title block of an authored docs page: the single
 * page-title h1 and the one-line description. Semantic only: Astro owns the
 * markup, frontend-designer owns later visual treatment. No islands, no scripts.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<header class="page-header">
  <h1>{title}</h1>
  <p class="page-header__description">{description}</p>
</header>

<style>
  .page-header {
    margin-block-end: 1.5rem;
  }
  .page-header h1 {
    margin: 0;
  }
  .page-header__description {
    margin: 0.25rem 0 0;
    color: var(--muted-foreground);
  }
</style>
