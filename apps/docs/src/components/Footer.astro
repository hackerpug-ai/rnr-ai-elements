---
/**
 * Footer (wireframe R14) — the DocsLayout footer slot: brand line, the two
 * sprint-02 section links, and the one-line product statement. Token-only
 * styling; no islands, no scripts.
 */
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">RNR AI Elements</p>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/components">Components</a>
      <a href="/registry">Registry</a>
    </nav>
    <p class="site-footer__note">
      Universal AI chat and agent UI components for React Native, distributed as a
      copy-paste registry — not an npm package.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--background);
    color: var(--muted-foreground);
    border-top: 1px solid var(--border);
  }
  .site-footer__inner {
    display: grid;
    gap: 0.75rem;
    max-width: 96rem;
    margin-inline: auto;
    padding: 2rem 1.5rem;
  }
  .site-footer__brand {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--foreground);
  }
  .site-footer__nav {
    display: flex;
    gap: 1rem;
  }
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* touch target */
    color: var(--foreground);
    text-decoration: none;
  }
  .site-footer__nav a:hover {
    color: var(--primary);
  }
  .site-footer__note {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
