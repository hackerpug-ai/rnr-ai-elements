---
/**
 * Footer (wireframe R14) — the DocsLayout footer slot: brand line, the
 * five-section site nav (GBC-013), and the one-line product statement.
 * Token-only styling; no islands, no scripts.
 *
 * GBC-013: the nav mirrors Header.astro's NAV_LINKS — same five hrefs, same
 * order (Components, Registry, Guides, Porting, Changelog). Header.astro is
 * the section-nav source of truth; keep the two lists identical.
 */
const FOOTER_LINKS = [
  { href: '/components', label: 'Components' },
  { href: '/registry', label: 'Registry' },
  { href: '/guides', label: 'Guides' },
  { href: '/porting', label: 'Porting' },
  { href: '/changelog', label: 'Changelog' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">RNR AI Elements</p>
    <nav class="site-footer__nav" aria-label="Footer">
      {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <p class="site-footer__note">
      Universal AI chat and agent UI components for React Native, distributed as a
      copy-paste registry — not an npm package.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--background);
    color: var(--muted-foreground);
    border-top: 1px solid var(--border);
  }
  .site-footer__inner {
    display: grid;
    gap: 0.75rem;
    max-width: 96rem;
    margin-inline: auto;
    padding: 2rem 1.5rem;
  }
  .site-footer__brand {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--foreground);
  }
  .site-footer__nav {
    display: flex;
    gap: 1rem;
  }
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* touch target */
    color: var(--foreground);
    text-decoration: none;
  }
  .site-footer__nav a:hover {
    color: var(--primary);
  }
  .site-footer__note {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
