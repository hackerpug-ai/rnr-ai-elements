---
/**
 * DataTable (REF-006) — the generic zero-JS table primitive. Columns, rows,
 * the tbody attribute passthrough, and the caption all arrive as props; the
 * component owns only table mechanics: zebra striping on var(--muted), a
 * sticky header row, and — under one max-width media query — a horizontally
 * scrolling wrapper with the first column pinned. Mono cells render as
 * <code>; plain cells render their text.
 *
 * 0 columns renders the bare-tbody form (the headerless single-column list).
 */
interface Props {
  /** Header labels; absent or empty renders no thead (the bare-tbody form). */
  columns?: readonly string[];
  /** Body rows: one array of cells per row; mono cells render as <code>. */
  rows: readonly { text: string; mono?: boolean }[][];
  /** Attributes spread onto the tbody (test hooks and the like). */
  bodyAttrs?: Record<string, string>;
  /** Table caption rendered when present. */
  caption?: string;
}

const { columns, rows, bodyAttrs, caption } = Astro.props;
---

<div class="data-table__scroll">
  <table class="data-table">
    {caption && <caption>{caption}</caption>}
    {columns && columns.length > 0 && (
      <thead>
        <tr>
          {columns.map((column) => (
            <th scope="col">{column}</th>
          ))}
        </tr>
      </thead>
    )}
    <tbody {...bodyAttrs}>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => (
            <td>{cell.mono ? <code>{cell.text}</code> : cell.text}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .data-table__scroll {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table caption {
    padding: 0.375rem 0.75rem;
    text-align: left;
    color: var(--muted-foreground);
  }
  .data-table th,
  .data-table td {
    padding: 0.375rem 0.75rem;
    text-align: left;
    border-top: 1px solid var(--border);
    background: var(--card);
  }
  .data-table thead th {
    position: sticky;
    top: 0;
  }
  .data-table tbody tr:nth-child(even) td {
    background: var(--muted);
  }
  /* Mobile: the table scrolls horizontally inside the wrapper with the first
     column pinned — no card-ification, no clipping. Base cell backgrounds are
     opaque token surfaces so the pinned column covers scrolled content; the
     even-row zebra above wins the cascade on zebra rows, keeping the pin
     continuous with its row. */
  @media (max-width: 48rem) {
    .data-table th:first-child,
    .data-table td:first-child {
      position: sticky;
      left: 0;
    }
  }
</style>
