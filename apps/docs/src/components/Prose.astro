---
/**
 * Prose (TR-07 R4, ORI-VIS-001) — the long-form article wrapper. Contains the
 * rendered Markdown/MDX content (the <Content /> component) with the locked
 * 70ch measure, anchored headings, and the shared reading rhythm: spaced
 * paragraphs, token-driven links (never the UA blue), quiet lists, and
 * long-line confinement for code and command surfaces. Zero JS; tokens only.
 * The type scale itself is TR-07's, set once in global.css — Prose owns only
 * rhythm, color application and containment.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
  }
  .prose :global(h2[id]),
  .prose :global(h3[id]) {
    scroll-margin-top: calc(var(--layout-header-h) + 1rem);
  }

  /* Long-form rhythm — prose owns its own spacing, not a cascade into the
     shell. Paragraphs breathe one blank line; headings announce sections. */
  .prose :global(p) {
    margin: 0 0 1rem;
    line-height: 1.65;
  }
  .prose :global(h2) {
    margin: 2.75rem 0 1rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    line-height: 1.45;
    text-wrap: balance;
  }
  /* A subheading directly after its section heading stays close to it. */
  .prose :global(h2 + h3) {
    margin-block-start: 1.25rem;
  }
  /* The opening heading of the article starts flush under the masthead. */
  .prose > :global(h2:first-child),
  .prose > :global(h3:first-child) {
    margin-block-start: 0;
  }

  /* Lists: the authored bullets and the tutorial's numbered steps. */
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-inline-start: 1.5rem;
  }
  .prose :global(li) {
    margin-block: 0.375rem;
  }
  .prose :global(li::marker) {
    color: var(--muted-foreground);
  }
  /* A command surface or nested block inside a step rides the step's rhythm. */
  .prose :global(li > *) {
    margin-block: 0.5rem;
  }

  /* Links resolve through the token sheet — foreground ink with a muted
     underline; the one accent appears on hover/keyboard focus. */
  .prose :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--muted-foreground);
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    color: var(--primary);
    text-decoration-color: var(--primary);
  }

  /* Quiet supporting matter. */
  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding: 0.25rem 0 0.25rem 1rem;
    border-inline-start: 2px solid var(--border);
    color: var(--muted-foreground);
  }
  .prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  /*
   * Markdown tables (GBC-017) — the declared twin of DataTable.astro's table
   * chrome, kept in lockstep with it: var(--muted) zebra on even rows,
   * var(--border) row dividers, the muted caption, the same cell rhythm,
   * border-collapse, tokens only, zero JS. Two deliberate divergences, both
   * because these prose tables hold ~5-7 rows where DataTable's chrome is
   * sized for 56 mono-key rows: the thead is NOT sticky — display:block plus
   * overflow-x:auto makes each table its own scroll container (overflow-x:auto
   * forces overflow-y to auto), so a sticky header would pin inside the table,
   * never below the site header, a computed 'sticky' that visibly does nothing
   * — and the first column is NOT pinned, so cells keep transparent surfaces
   * (DataTable's opaque var(--card) base exists only to cover scrolled content
   * under the pin). The accessibility floor for scope/caption is content's:
   * this block styles a caption when one is authored; it cannot add one.
   *
   * :not(.data-table): a DataTable composition rendered inside a prose body
   * (TokenTable on /docs/theming) owns its chrome and its OWN scroll wrapper
   * (DataTable.astro's .data-table__scroll); display:block here would turn the
   * table element itself into the scroll container, leaving that wrapper with
   * nothing to scroll and breaking the mobile pinned-column contract the
   * reading/token lanes assert.
   */
  .prose :global(table:not(.data-table)) {
    display: block;
    overflow-x: auto;
    margin: 0 0 1rem;
    border-collapse: collapse;
  }
  .prose :global(caption) {
    padding: 0.375rem 0.75rem;
    text-align: left;
    color: var(--muted-foreground);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border);
  }
  /* Sentence-length deviation cells wrap instead of blowing the layout. */
  .prose :global(td) {
    overflow-wrap: anywhere;
  }
  .prose :global(tbody tr:nth-child(even) td) {
    background: var(--muted);
  }
  /* Below 48rem the first column caps at a label width, keeping the wrapped
     deviation cells a scannable band rather than a crushed sliver. DataTable
     compositions keep their own pinned-column mobile behavior. */
  @media (max-width: 48rem) {
    .prose :global(table:not(.data-table) th:first-child),
    .prose :global(table:not(.data-table) td:first-child) {
      max-width: 10rem;
    }
  }

  /* Rendered code fences (Expressive Code) stay full-width inside the measure
     and scroll their own pre when a line outgrows it. */
  .prose :global(.expressive-code) {
    margin-block: 1.5rem;
  }
  .prose :global(.expressive-code pre) {
    overflow-x: auto;
  }

  /*
   * Command containment (AC-4): inside the reading surface a long install
   * command is ONE line — it never wraps mid-URL and never widens the page.
   * The code surface becomes its own horizontal scroller, and the mono token
   * (Spline Sans Mono Variable) governs the glyphs. Scoped to .prose so the
   * ledger and reference pages keep their own established strip treatment.
   */
  .prose :global(.copy-button) {
    font-family: var(--font-mono);
    min-width: 0;
  }
  .prose :global(.copy-button__command) {
    flex: 1 1 12rem;
    min-width: 0;
    white-space: pre;
    overflow-x: auto;
  }
</style>
