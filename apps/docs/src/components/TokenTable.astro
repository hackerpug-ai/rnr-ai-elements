---
/**
 * TokenTable (ORI-AST-003 data contract; ORI-VIS-002 presentation) — the live
 * Theming token map, composed through the shared DataTable rich-cell slot so
 * every table mechanic (scroll wrapper, zebra bands, sticky header, the mobile
 * pinned identifying column) lives in exactly one implementation.
 *
 * Build-time, this component reads the REAL docs token sheet
 * (`apps/docs/src/styles/global.css`) and the authored usage metadata
 * (`apps/docs/src/data/token-usage.json`), and derives one paired row per
 * semantic color token through `scripts/docs-data/token-map`. Both the light
 * and dark columns are written into the static HTML, so the map is fully
 * readable with JavaScript disabled; the live-value cells carry an honest
 * em-dash placeholder the island overwrites (never a canned value).
 *
 * Live, the swatch chip resolves `var(--<token>)` directly — it re-themes for
 * free when the root class flips — and the `[data-token-current]` cell is
 * filled by the existing `rnr-theme-toggle` island (theme-toggle.ts reads the
 * computed custom property and writes the text). No new island, no script of
 * its own: the table only publishes the observation targets.
 *
 * DOCS-ONLY: the code-background / code-foreground rows carry a `DOCS-ONLY`
 * badge — those two pairs are consumed by this site's code frames and install
 * strips, never by a registry item.
 *
 * Presentation notes: the extra `token-table__scroll` wrapper class and the
 * `data-token-table` table attribute are the established observation hooks
 * (the reading-presentation and theme-toggle lanes select them); cell-level
 * styles below are scoped to this component's slotted cells, and the few
 * table-wide rules are :global under the unique wrapper class — the same
 * containment argument DataTable itself makes for its cell chrome.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import DataTable from './DataTable.astro';
import { deriveTokenMap, type TokenUsage } from '../../../../scripts/docs-data/token-map';

// `astro build` runs with cwd at the docs app root (the catch-all uses the same
// process.cwd() convention), so the source files resolve there — never from
// import.meta.url, which points at the compiled dist chunk during prerender.
const srcDir = join(process.cwd(), 'src');
const css = readFileSync(join(srcDir, 'styles/global.css'), 'utf8');
const usage = JSON.parse(readFileSync(join(srcDir, 'data/token-usage.json'), 'utf8')) as Record<
  string,
  TokenUsage
>;

const rows = deriveTokenMap(css, usage);

const COLUMNS = ['Token', 'Usage', 'Light', 'Dark', 'Swatch', 'Current'];
---

<DataTable
  columns={COLUMNS}
  wrapperClass="token-table__scroll"
  tableAttrs={{ 'data-token-table': '' }}
>
  <Fragment>
    {rows.map((row) => (
      <tr data-token={row.name}>
        <th scope="row" class="token-table__name">
          <code>{row.property}</code>
          {row.docsOnly && <span class="token-table__docs-only" data-docs-only>DOCS-ONLY</span>}
        </th>
        <td data-usage>{row.usage}</td>
        <td data-value="light"><code>{row.light}</code></td>
        <td data-value="dark"><code>{row.dark}</code></td>
        <td>
          <span class="token-table__swatch" data-swatch style={`background: var(${row.property})`}
          ></span>
        </td>
        <td>
          <code class="token-table__current" data-token-current={row.property}>—</code>
        </td>
      </tr>
    ))}
  </Fragment>
</DataTable>

<style>
  /* Table-wide sizing under the unique wrapper class (same containment
     argument as DataTable's own :global cell chrome): the six-column map
     reads at the smaller scale; the header goes quiet. */
  :global(.token-table__scroll .data-table) {
    font-size: 0.875rem;
  }
  :global(.token-table__scroll .data-table thead th) {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  /* Slotted cells carry this component's scope hash, so element selectors
     below hit only TokenTable cells. */
  td {
    vertical-align: top;
  }
  td code {
    white-space: nowrap;
  }
  .token-table__name {
    font-weight: 600;
  }
  .token-table__docs-only {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  /* The live swatch: a fixed chip resolving the token itself, so it re-themes
     when the root class flips. A token border keeps near-canvas colors visible. */
  .token-table__swatch {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .token-table__current {
    color: var(--foreground);
  }
</style>
