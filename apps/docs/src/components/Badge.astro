---
/**
 * Badge — THE one site-wide verdict pattern (ComponentCard, detail chip rows,
 * ledger rows later). Exactly two tones, both named: Expo Go (positive, the
 * default foreground/background pairing) and dev-client (warning, keyed to
 * --destructive — >=4.5:1 in both themes). Zero JS; tokens only.
 */
type BadgeTone = 'expo-go' | 'dev-client';

interface Props {
  tone?: BadgeTone;
  class?: string;
}

const { tone = 'expo-go', class: className } = Astro.props;

const VERDICTS: Record<BadgeTone, string> = {
  'expo-go': 'Expo Go',
  'dev-client': 'dev-client',
};
---

<span class:list={['badge', `badge--${tone}`, className]}>{VERDICTS[tone]}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.55;
    white-space: nowrap;
  }

  /* Dev-client warning — the error tone, >=4.5:1 against the page canvas. */
  .badge--dev-client {
    background: transparent;
    border-color: var(--destructive);
    color: var(--destructive);
  }
</style>
