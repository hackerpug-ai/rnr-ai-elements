---
/**
 * DependencyPanel (SHELL-008) — the item page's data-verbatim dependencies
 * panel. Receives the item's raw arrays plus the resolved-per-engine URL
 * pairs ([item].astro resolves through lib/resolve-deps in frontmatter, so
 * the served HTML is already concrete — nothing is fetched or templated on
 * the client) and renders:
 *
 * - the npm dependency list verbatim, or an explicit empty state when the
 *   dataset's dependencies[] is empty (the section never silently drops),
 * - one engine-tabbed table of the resolved registry dependency URLs per
 *   engine — both forms render; the inactive one is hidden-attribute only,
 * - the project-level AI SDK peers line verbatim from site-facts.json.
 *
 * Plain token-styled table: the DataTable polish stays sprint-04's. Every
 * rendered string arrives as a prop — a dataset edit moves this panel.
 */
import type { AiSdkPeer } from '../lib/resolve-deps';
import TabGroup from './islands/TabGroup.astro';

interface Props {
  /** The item's dependencies[] — npm package names, rendered verbatim. */
  dependencies: readonly string[];
  /** resolve-deps.ts output per engine — already concrete absolute URLs. */
  registryUrls: { nativewind: readonly string[]; uniwind: readonly string[] };
  /** site-facts.json aiSdkPeers, rendered verbatim. */
  peers: readonly AiSdkPeer[];
}

const { dependencies, registryUrls, peers } = Astro.props;
---

{
  dependencies.length === 0 ? (
    <p class="deps-empty" data-deps-empty>
      No required npm packages — this item installs through the registry dependencies below.
    </p>
  ) : (
    <ul class="deps-packages" data-deps-packages>
      {dependencies.map((name) => (
        <li>
          <code>{name}</code>
        </li>
      ))}
    </ul>
  )
}
<TabGroup
  panels={[
    { engine: 'nativewind', label: 'nativewind' },
    { engine: 'uniwind', label: 'uniwind' },
  ]}
>
  <Fragment slot="nativewind">
    <table class="deps-urls">
      <tbody data-engine-urls="nativewind">
        {registryUrls.nativewind.map((url) => (
          <tr>
            <td>
              <code>{url}</code>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </Fragment>
  <Fragment slot="uniwind">
    <table class="deps-urls">
      <tbody data-engine-urls="uniwind">
        {registryUrls.uniwind.map((url) => (
          <tr>
            <td>
              <code>{url}</code>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </Fragment>
</TabGroup>
{
  peers.length > 0 && (
    <p class="deps-peers" data-deps-peers>
      <span>AI SDK peers:</span>
      {peers.map((peer) => (
        <code>{peer.name}@{peer.range}</code>
      ))}
    </p>
  )
}

<style>
  .deps-packages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 0.75rem;
    list-style: none;
  }
  .deps-packages code {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .deps-empty {
    margin: 0 0 0.75rem;
    color: var(--muted-foreground);
  }
  .deps-urls {
    width: 100%;
    border-collapse: collapse;
  }
  .deps-urls td {
    border-top: 1px solid var(--border);
    padding: 0.375rem 0;
  }
  .deps-urls code {
    overflow-wrap: anywhere;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .deps-peers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    color: var(--muted-foreground);
  }
  .deps-peers code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
