---
// Interim wiring (SHELL-001): global tokens for pages still served through spike.astro.
// SHELL-002's DocsLayout import supersedes this; SHELL-008 deletes spike.astro.
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
