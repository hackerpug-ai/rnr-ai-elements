{
  "name": "@rnr-ai-elements/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "tsx ../../scripts/docs-data/prebuild.ts",
    "check:snippets": "tsx ../../scripts/docs-data/authored-snippets.ts",
    "search:index": "tsx ../../scripts/docs-data/search-index.ts",
