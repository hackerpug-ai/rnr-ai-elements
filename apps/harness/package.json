  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "storybook:device": "EXPO_PUBLIC_STORYBOOK_ENABLED=true ENGINE=uniwind expo start --clear",
    "storybook:web": "ENGINE=uniwind storybook dev -p 6006 -c .storybook-web",
    "storybook:web:nativewind": "ENGINE=nativewind storybook dev -p 6007 -c .storybook-web",
    "storybook:web:both": "concurrently -n uniwind,nativewind -c cyan,magenta \"pnpm storybook:web\" \"pnpm storybook:web:nativewind\"",
    "storybook:device:nativewind": "ENGINE=nativewind STORYBOOK=1 expo start",
    "build:uniwind": "ENGINE=uniwind expo export --platform web --output-dir /tmp/rnr-ai-uniwind",
    "build:nativewind": "ENGINE=nativewind expo export --platform web --output-dir /tmp/rnr-ai-nativewind",
    "storybook:device:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true ENGINE=uniwind expo start --ios --clear"
  },
  "private": true
