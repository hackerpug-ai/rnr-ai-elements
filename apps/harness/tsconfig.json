{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/components/ai/*": [
        "../../packages/registry/src/components/ai/*"
      ],
      "@/components/ui/*": [
        "../../packages/registry/src/components/ui/*",
        "./src/components/ui/*"
      ],
      "@/registry/{engine}/components/ai/*": [
        "../../packages/registry/src/components/ai/*"
      ],
      "@/registry/{engine}/components/ui/*": [
        "./src/components/ui/*",
        "../../packages/registry/src/components/ui/*"
      ],
      "@/registry/{engine}/lib/*": [
        "./src/lib/*",
        "../../packages/registry/src/lib/*"
      ],
      "react-native-webview": [
        "./node_modules/react-native-webview"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "allowArbitraryExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}