{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@/registry/{engine}/components/ai/*": ["./src/components/ai/*"],
      "@/registry/{engine}/lib/mono": ["./src/lib/mono.ts"],
      "@/registry/{engine}/lib/markdown": ["./src/lib/markdown.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"]
}
