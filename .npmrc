# node-linker=hoisted was removed deliberately.
#
# Hoisting flattens the tree, so `nativewind` landed in the ROOT node_modules and
# resolved the root's tailwindcss@4 instead of its own package-local v3 — which is
# exactly the "NativeWind only supports Tailwind CSS v3" failure. Two Tailwind majors
# cannot coexist under a hoisted linker.
#
# pnpm's default isolated linker keeps each package's deps local, which is what lets
# apps/harness run Tailwind v4 (Uniwind) and apps/harness-nativewind run v3 (NativeWind)
# side by side. Metro has supported symlinks for several versions.
shamefully-hoist=false
