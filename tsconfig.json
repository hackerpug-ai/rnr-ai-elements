{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "packages/registry/scripts/**/*.ts",
    "packages/registry/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "apps", "**/*.tsx"]
}
