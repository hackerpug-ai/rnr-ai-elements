{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/registry/{engine}/lib/*": ["./packages/registry/src/lib/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "packages/registry/scripts/**/*.ts",
    "packages/registry/src/lib/markdown.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages/registry/src/components",
    "packages/registry/src/lib/mono.ts"
  ]
}
