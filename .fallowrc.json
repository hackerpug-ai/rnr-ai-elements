{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.25.0/schema.json",
  "minimumVersion": "3.25.0",
  "entry": ["packages/registry/src/**/*.ts", "packages/registry/src/**/*.tsx"],
  "dynamicallyLoaded": ["apps/docs/src/components/IndexList.astro"],
  "ignorePatterns": [
    "packages/docs-snippets/**",
    ".spec/**",
    ".kb-run-sprint/**",
    ".pi/**",
    ".claude/**",
    ".tmp/**",
    "apps/docs/.astro/**",
    "apps/docs/playwright-report/**",
    "test-results/**"
  ]
}
